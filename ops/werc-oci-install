#!/bin/sh
# Alpine/OpenRC, installed from a reviewed checkout. Safe to run again.
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ "$(id -u)" -eq 0 ] || { echo 'Run with doas' >&2; exit 1; }
cd "$(dirname "$0")"
apk add --no-cache podman shadow-subids passt curl git flock su-exec caddy
if ! command -v cloudflared >/dev/null; then
    # Official release, pinned and verified. Alpine has no cloudflared package.
    case "$(uname -m)" in
        x86_64) arch=amd64; checksum=d33ff2d14475178d2012c2c56beba87389ac5ded27649519f198a7d3134a99db ;;
        aarch64) arch=arm64; checksum=e6422b9d4f72d3194bc5a38676f13667c06666523217b842a877d72a80b5ac08 ;;
        *) echo 'Unsupported cloudflared architecture' >&2; exit 1 ;;
    esac
    download=$(mktemp)
    trap 'rm -f "$download"' EXIT
    curl -fSL --connect-timeout 15 --max-time 180 \
        "https://github.com/cloudflare/cloudflared/releases/download/2026.10.0/cloudflared-linux-$arch" \
        -o "$download"
    printf '%s  %s\n' "$checksum" "$download" | sha256sum -c -
    install -m 0755 -o root -g root "$download" /usr/local/bin/cloudflared
    rm -f "$download"
    trap - EXIT
fi
if ! id werc >/dev/null 2>&1; then
    adduser -S -D -h /var/lib/werc -s /sbin/nologin werc
fi
install -d -m 0700 -o werc -g werc /var/lib/werc

touch /etc/subuid /etc/subgid
for file in /etc/subuid /etc/subgid; do
    if ! grep -q '^werc:' "$file"; then
        # Allocate after all existing ranges, avoiding other users' mappings.
        start=$(awk -F: 'BEGIN { nextid=100000 } $2+$3>nextid { nextid=$2+$3 } END { print nextid }' /etc/subuid /etc/subgid)
        printf 'werc:%s:65536\n' "$start" >> "$file"
    fi
done

install -d -m 0755 -o root -g root /etc/werc-oci
install -d -m 0700 -o werc -g werc /run/werc-oci
backup=/etc/werc-oci/previous-install
install -d -m 0700 "$backup"
for script in werc-podman werc-oci-stage werc-oci-promote werc-oci-deploy; do
    [ ! -f "/usr/local/sbin/$script" ] || cp -p "/usr/local/sbin/$script" "$backup/"
    install -m 0755 -o root -g root "$script" "/usr/local/sbin/$script"
done
[ ! -f /etc/init.d/werc-oci ] || cp -p /etc/init.d/werc-oci "$backup/"
install -m 0755 -o root -g root werc-oci-openrc /etc/init.d/werc-oci
[ ! -f /etc/init.d/cloudflared ] || cp -p /etc/init.d/cloudflared "$backup/"
install -m 0755 -o root -g root cloudflared-openrc /etc/init.d/cloudflared

if [ ! -f /etc/werc-oci/active-slot ]; then
    echo none > /etc/werc-oci/active-slot
    install -d -m 0755 /etc/caddy
    [ ! -f /etc/caddy/Caddyfile ] || cp -p /etc/caddy/Caddyfile "$backup/"
    # This installer provisions the notebook as this site's server.
    cp Caddyfile /etc/caddy/Caddyfile
    chmod 0644 /etc/caddy/Caddyfile
fi
chmod 0644 /etc/werc-oci/active-slot
if [ ! -f /etc/caddy/Caddyfile ]; then
    install -d -m 0755 /etc/caddy
    case "$(cat /etc/werc-oci/active-slot)" in
        blue|none) port=18085 ;;
        green) port=18086 ;;
        *) echo 'Invalid active slot' >&2; exit 1 ;;
    esac
    sed "s/:18085/:$port/" Caddyfile > /etc/caddy/Caddyfile
    chmod 0644 /etc/caddy/Caddyfile
fi
install -d -m 0700 -o root -g root /etc/cloudflared

# Add exactly one scheduled deployment. Existing cron jobs stay intact.
cron='* * * * * /usr/local/sbin/werc-oci-deploy 2>&1 | /usr/bin/logger -t werc-deploy'
touch /etc/crontabs/root
if ! grep -Fq '/usr/local/sbin/werc-oci-deploy' /etc/crontabs/root; then
    printf '\n%s\n' "$cron" >> /etc/crontabs/root
fi
# BusyBox crond detects directory changes; editing a file alone can wait an hour.
touch /etc/crontabs
rc-update add cgroups default
rc-update add werc-oci default
rc-update add caddy default
rc-update add cloudflared default
rc-update add crond default
rc-service crond start
echo "Installed. Previous scripts: $backup"
echo 'Run: rc-service werc-oci restore; werc-oci-deploy'

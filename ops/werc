#!/bin/sh
# Site commands, shared HTTP checks and dedicated rootless Podman storage.
set -eu
command=${1:-help}
[ "$#" -eq 0 ] || shift
case "$command" in
    help)
        echo 'Usage: werc {update [SHA]|start|stop|restart|status|logs|rollback|pause|resume}'
        echo 'Checks: werc check URL SHA'
        exit 0 ;;
    check)
        [ "$#" -eq 2 ] || { echo 'Usage: werc check URL SHA' >&2; exit 2; }
        base=${1%/}
        sha=$2
        case "$sha" in ''|*[!0123456789abcdef]*) echo 'Invalid SHA' >&2; exit 2 ;; esac
        [ "${#sha}" -eq 40 ] || { echo 'Expected a full commit SHA' >&2; exit 2; }
        http() { curl --max-time 5 -H 'Host: arthurgusmao.com.br' "$@"; }
        attempt=0
        until [ "$(http -fsS "$base/pub/meta/revision.txt" 2>/dev/null || :)" = "$sha" ]; do
            attempt=$((attempt + 1))
            [ "$attempt" -lt 10 ] || { echo 'HTTP revision check failed' >&2; exit 1; }
            sleep 1
        done
        http -fsS "$base/" | grep -F '<h1>Arthur Gusmão</h1>' >/dev/null
        for path in about/ projects/ notes/ pub/style/style.css pub/fonts/oxanium.woff2; do
            http -fsS -o /dev/null "$base/$path"
        done
        [ "$(http -sS -o /dev/null -w '%{http_code}' "$base/_werc/config")" = 403 ]
        exit ;;
    podman)
        [ "$(id -un)" = werc ] || { echo 'Run Podman as werc' >&2; exit 1; }
        export XDG_RUNTIME_DIR=/run/werc-oci
        exec /usr/bin/podman --root /var/lib/werc/.local/share/werc-oci/storage \
            --runroot /run/werc-oci/storage --tmpdir /run/werc-oci/libpod "$@" ;;
esac
[ "$(id -u)" -eq 0 ] || { echo "Run with doas: doas werc $command" >&2; exit 1; }
run() { su-exec werc env HOME=/var/lib/werc "$@"; }
case "$command" in
    update)
        [ "$#" -le 1 ] || { echo 'Usage: werc update [SHA]' >&2; exit 2; }
        run /usr/local/sbin/werc-deploy "$@" ;;
    start|restart) rc-service werc-site "$command"; rc-service cloudflared "$command" ;;
    stop) rc-service cloudflared stop; rc-service werc-site stop ;;
    rollback) touch /etc/werc/paused; run /usr/local/sbin/werc-deploy rollback ;;
    status) rc-service werc-site verify; run /usr/local/sbin/werc podman ps -a ;;
    logs) run /usr/local/sbin/werc podman logs --tail 50 werc-site ;;
    pause) touch /etc/werc/paused ;;
    resume) rm -f /etc/werc/paused ;;
    *) echo 'Unknown command. Run: werc help' >&2; exit 2 ;;
esac

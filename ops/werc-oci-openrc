#!/sbin/openrc-run

description="Restore and verify rootless werc OCI slots"
extra_commands="verify restore"
description_verify="Verify active OCI revision over HTTP"
description_restore="Restore OCI containers without stopping production"

slotfile=/etc/werc-oci/active-slot
runtime_dir=/run/werc-oci

depend() {
    need localmount cgroups
    use net
    before caddy
}

podman_aw() {
    /sbin/su-exec aw /usr/bin/env \
        HOME=/home/aw \
        USER=aw \
        LOGNAME=aw \
        XDG_RUNTIME_DIR=$runtime_dir \
        /usr/bin/podman "$@"
}

active_container() {
    [ -f "$slotfile" ] || return 1

    case "$(cat "$slotfile")" in
        blue) printf '%s\n' werc-blue ;;
        green) printf '%s\n' werc-green ;;
        legacy) return 2 ;;
        *) return 1 ;;
    esac
}

slot_port() {
    case "$1" in
        werc-blue) printf '%s\n' 18085 ;;
        werc-green) printf '%s\n' 18086 ;;
        *) return 1 ;;
    esac
}

verify_container() {
    name=$1
    port=$(slot_port "$name") || return 1

    running=$(podman_aw inspect \
        -f '{{.State.Running}}' "$name" 2>/dev/null) || return 1

    [ "$running" = true ] || return 1

    expected=$(podman_aw inspect \
        -f '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
        "$name" 2>/dev/null) || return 1

    case "$expected" in
        ''|*[!0123456789abcdef]*) return 1 ;;
    esac

    [ "${#expected}" -eq 40 ] || return 1

    actual=$(/usr/bin/curl -fsS --max-time 3 \
        -H 'Host: arthurgusmao.com.br' \
        "http://127.0.0.1:$port/pub/meta/revision.txt" \
        2>/dev/null) || return 1

    [ "$actual" = "$expected" ]
}

ensure_ready() {
    name=$1
    max_attempts=${2:-8}
    attempt=1
    logfile=/var/log/werc-oci.log

    while [ "$attempt" -le "$max_attempts" ]; do
        running=$(podman_aw inspect \
            -f '{{.State.Running}}' "$name" \
            2>>"$logfile") || running=''

        if [ "$running" != true ]; then
            if ! podman_aw start "$name" >>"$logfile" 2>&1; then
                printf '%s: %s start failed (attempt %s)\n' \
                    "$(date -Is)" "$name" "$attempt" \
                    >>"$logfile"
            fi
        fi

        if verify_container "$name"; then
            return 0
        fi

        printf '%s: %s not ready (attempt %s/%s)\n' \
            "$(date -Is)" "$name" "$attempt" "$max_attempts" \
            >>"$logfile"

        [ "$attempt" -eq "$max_attempts" ] && break
        sleep 2
        attempt=$((attempt + 1))
    done

    printf '%s: %s failed readiness verification\n' \
        "$(date -Is)" "$name" >>"$logfile"
    return 1
}
start_pre() {
    # Keep rootless container state independent of graphical login mounts.
    checkpath -d -m 0700 -o aw:aw "$runtime_dir"
}

start() {
    if name=$(active_container); then
        :
    else
        result=$?

        if [ "$result" -eq 2 ]; then
            einfo "Legacy werc is selected"
            return 0
        fi

        eerror "Invalid active slot"
        return 1
    fi

    ebegin "Restoring active container $name"

    if ! ensure_ready "$name"; then
        eend 1 "Active container failed readiness verification"
        return 1
    fi

    eend 0

    case "$name" in
        werc-blue) standby=werc-green ;;
        werc-green) standby=werc-blue ;;
    esac

    if podman_aw container exists "$standby"; then
        if ensure_ready "$standby" 2; then
            einfo "Standby container $standby is ready"
        else
            ewarn "Standby $standby is unavailable"
        fi
    fi

    return 0
}

verify() {
    if name=$(active_container); then
        :
    else
        result=$?

        if [ "$result" -eq 2 ]; then
            einfo "Legacy is selected; OCI verification skipped"
            return 0
        fi

        eerror "Invalid active slot"
        return 1
    fi

    if verify_container "$name"; then
        einfo "$name: revision verified"
        return 0
    fi

    eerror "$name: revision verification failed"
    return 1
}

status() {
    verify
}

stop() {
    ebegin "Stopping werc OCI containers"

    result=0

    for name in werc-blue werc-green; do
        running=$(podman_aw inspect \
            -f '{{.State.Running}}' "$name" 2>/dev/null) || continue

        if [ "$running" = true ]; then
            podman_aw stop "$name" >/dev/null || result=1
        fi
    done

    eend "$result"
}

restore() {
    start
}

#!/bin/sh
# POSIX sh; runs as aw from the authenticated webhook.
set -eu
umask 077

REPO=${WERCD_REPO:-/home/aw/deploy/site}
SITE=${WERCD_SITE:-/srv/werc/sites/arthurgusmao.com.br}
PUB=${WERCD_PUB:-/srv/werc/pub}
STATE=${WERCD_STATE:-/home/aw/.local/state/werc-deploy}
WEB=${WERCD_WEB:-https://arthurgusmao.com.br}
MARKER=${WERCD_MARKER:-/home/aw/.cache/werc-deployed-commit}
SHA=${1:-}
export GIT_TERMINAL_PROMPT=0

case "$SHA" in
    ''|*[!0123456789abcdef]*) echo 'Invalid SHA' >&2; exit 1 ;;
esac
[ "${#SHA}" -eq 40 ] || { echo 'Invalid SHA length' >&2; exit 1; }

mkdir -p "$STATE/backups"
chmod 700 "$STATE" "$STATE/backups"
LOCK=$STATE/lock
if ! mkdir "$LOCK" 2>/dev/null; then
    echo 'Deployment already running (or stale lock)' >&2
    exit 1
fi

BACKUP=
ROLLBACK=0
STAMP=$PUB/meta/revision.txt

restore() {
    rsync -a --delete "$BACKUP/site/" "$SITE/" || return 1
    rsync -a --delete "$BACKUP/style/" "$PUB/style/" || return 1
    rsync -a --delete "$BACKUP/fonts/" "$PUB/fonts/" || return 1
    if [ -f "$BACKUP/revision.txt" ]; then
        cp -p "$BACKUP/revision.txt" "$STAMP" || return 1
    else
        rm -f "$STAMP" || return 1
    fi
    if [ -f "$BACKUP/deployed-commit" ]; then
        cp -p "$BACKUP/deployed-commit" "$MARKER" || return 1
    else
        rm -f "$MARKER" || return 1
    fi
}

finish() {
    code=$1
    trap - 0 1 2 3 15
    if [ "$ROLLBACK" -eq 1 ]; then
        echo "Deployment failed; restoring snapshot $BACKUP" >&2
        if restore; then
            echo 'Rollback finished' >&2
        else
            echo "CRITICAL: rollback failed; inspect $BACKUP" >&2
        fi
        code=1
    fi
    rmdir "$LOCK" || echo "WARNING: could not remove $LOCK" >&2
    exit "$code"
}
trap 'finish $?' 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 131' 3
trap 'exit 143' 15

cd "$REPO"
echo 'Fetching origin/master'
git fetch --quiet origin master
LATEST=$(git rev-parse refs/remotes/origin/master)
if [ "$LATEST" != "$SHA" ]; then
    echo "Rejecting stale deployment $SHA (latest: $LATEST)" >&2
    exit 1
fi
git checkout --quiet --detach --force "$SHA"
test -s site/index.md
test -s pub/style/style.css
test -s pub/fonts/oxanium.woff2

# Store a private, complete snapshot of the currently published directories.
BACKUP=$(mktemp -d "$STATE/backups/release.XXXXXXXX")
mkdir -p "$BACKUP/site" "$BACKUP/style" "$BACKUP/fonts"
rsync -a "$SITE/" "$BACKUP/site/"
rsync -a "$PUB/style/" "$BACKUP/style/"
rsync -a "$PUB/fonts/" "$BACKUP/fonts/"
[ ! -f "$STAMP" ] || cp -p "$STAMP" "$BACKUP/revision.txt"
[ ! -f "$MARKER" ] || cp -p "$MARKER" "$BACKUP/deployed-commit"

# From this point on, any error restores the snapshot.
ROLLBACK=1
rsync -a --delete --chmod=Du+rwx,Dgo+rx,Fu+rw,Fgo+r,Fgo+X \
    --exclude='/_werc/config' --exclude='.git/' \
    --exclude='.env*' --exclude='*.key' --exclude='*.pem' \
    site/ "$SITE/"
rsync -a --delete --chmod=Du+rwx,Dgo+rx,Fu+rw,Fgo+r,Fgo+X \
    pub/style/ "$PUB/style/"
rsync -a --delete --chmod=Du+rwx,Dgo+rx,Fu+rw,Fgo+r,Fgo+X \
    pub/fonts/ "$PUB/fonts/"

# Atomically replace the revision stamp (not the whole website).
mkdir -p "$PUB/meta"
chmod 755 "$PUB/meta"
REV_TMP=$(mktemp "$PUB/meta/.revision.XXXXXXXX")
printf '%s\n' "$SHA" > "$REV_TMP"
chmod 644 "$REV_TMP"
mv -f "$REV_TMP" "$STAMP"

# Confirm that the public Cloudflare path exposes the new revision and HTML.
OK=0
for attempt in 1 2 3; do
    GOT=$(curl -fsSL --connect-timeout 4 --max-time 10 \
        -H 'Cache-Control: no-cache' \
        "$WEB/pub/meta/revision.txt?rev=$SHA" 2>/dev/null || :)
    if [ "$GOT" = "$SHA" ] && \
       curl -fsSL --connect-timeout 4 --max-time 10 \
           "$WEB/?rev=$SHA" -o "$BACKUP/health.html" && \
       grep -qi '<html' "$BACKUP/health.html"; then
        OK=1
        break
    fi
    echo "Health check failed (attempt $attempt)" >&2
    sleep 2
done
[ "$OK" -eq 1 ] || { echo 'Public health check failed' >&2; exit 1; }

# Keep marker unchanged until the public checks pass.
printf '%s\n' "$SHA" > "$MARKER"
ROLLBACK=0
echo "Deployment completed and verified: $SHA"
echo "Previous version saved in: $BACKUP"

#!/bin/sh
set -eu
umask 077

[ "$(id -u)" -eq 0 ] || {
    echo "Run with doas" >&2
    exit 1
}

[ "$#" -eq 1 ] || {
    echo "Usage: $0 blue|green|legacy" >&2
    exit 2
}

case "$1" in
    legacy) target=legacy; port=8081 ;;
    blue) target=blue; port=18085 ;;
    green) target=green; port=18086 ;;
    *) echo "Invalid slot" >&2; exit 2 ;;
esac

conf=/etc/caddy/Caddyfile
slotfile=/etc/werc-oci/active-slot
lock=/etc/werc-oci/promote.lock
host=arthurgusmao.com.br

[ -f "$conf" ] && [ -f "$slotfile" ] || exit 1

if ! mkdir "$lock" 2>/dev/null; then
    echo "Another promotion may be running" >&2
    exit 1
fi

old=$(cat "$slotfile")

case "$old" in
    legacy) oldport=8081 ;;
    blue) oldport=18085 ;;
    green) oldport=18086 ;;
    *)
        echo "Invalid active slot" >&2
        rmdir "$lock"
        exit 1
        ;;
esac

backup=$(mktemp /etc/werc-oci/Caddyfile.backup.XXXXXX)
candidate=$(mktemp /etc/caddy/Caddyfile.candidate.XXXXXX)
armed=0

set_slot() {
    state_tmp=$(mktemp /etc/werc-oci/active-slot.XXXXXX)
    printf '%s\n' "$1" > "$state_tmp"
    chmod 644 "$state_tmp"
    mv -f "$state_tmp" "$slotfile"
}

cleanup() {
    result=$?
    trap - 0 2 15

    if [ "$armed" -eq 1 ] && [ "$result" -ne 0 ]; then
        echo "ROLLBACK: restoring $old" >&2

        restore=$(mktemp /etc/caddy/Caddyfile.restore.XXXXXX)

        if cp -p "$backup" "$restore" &&
           mv -f "$restore" "$conf"; then
            if ! caddy reload --config "$conf" \
                --adapter caddyfile; then
                echo "URGENT: Caddy rollback reload failed" >&2
            fi
        else
            echo "URGENT: Caddyfile restore failed" >&2
        fi

        set_slot "$old" || \
            echo "URGENT: slot restore failed" >&2
    fi

    rm -f "$candidate"
    rmdir "$lock" 2>/dev/null || :
    exit "$result"
}

trap cleanup 0
trap 'exit 130' 2
trap 'exit 143' 15

current=$(
    /bin/sed -n \
      's/^[[:space:]]*reverse_proxy[[:space:]]*127[.]0[.]0[.]1:\([0-9][0-9]*\)[[:space:]]*$/\1/p' \
      "$conf"
)

[ "$current" = "$oldport" ] || {
    echo "Caddy and active-slot disagree" >&2
    exit 1
}

if [ "$old" = "$target" ]; then
    echo "Already active: $target"
    exit 0
fi

origin="http://127.0.0.1:$port"

expected=$(curl -fsS --max-time 5 \
    -H "Host: $host" \
    "$origin/pub/meta/revision.txt")

case "$expected" in
    ''|*[!0123456789abcdef]*)
        echo "Invalid revision" >&2
        exit 1
        ;;
esac

[ "${#expected}" -eq 40 ] || exit 1

page=$(curl -fsS --max-time 5 \
    -H "Host: $host" "$origin/")

printf '%s\n' "$page" |
    grep -Fq '<h1>Arthur Gusmão</h1>'

curl -fsS --max-time 5 \
    -H "Host: $host" \
    "$origin/pub/style/style.css" -o /dev/null

private_status=$(curl -sS --max-time 5 \
    -H "Host: $host" \
    -o /dev/null -w '%{http_code}' \
    "$origin/_werc/config")

[ "$private_status" = 403 ] || {
    echo "Private configuration is not protected" >&2
    exit 1
}

cp -p "$conf" "$backup"

/bin/sed \
  "s/\(reverse_proxy[[:space:]]*127[.]0[.]0[.]1:\)$oldport\([[:space:]]*\)$/\1$port\2/" \
  "$conf" > "$candidate"

chmod 644 "$candidate"

caddy validate \
    --config "$candidate" \
    --adapter caddyfile

echo "Promoting $old -> $target"

armed=1
set_slot "$target"

mv -f "$candidate" "$conf"

caddy reload \
    --config "$conf" \
    --adapter caddyfile

actual=$(curl -fsS --max-time 8 \
    -H "Host: $host" \
    http://127.0.0.1:8080/pub/meta/revision.txt)

[ "$actual" = "$expected" ] || {
    echo "Local Caddy revision mismatch" >&2
    exit 1
}

verified=0
i=1

while [ "$i" -le 3 ]; do
    actual=$(curl -fsSL \
        --connect-timeout 6 \
        --max-time 15 \
        -H 'Cache-Control: no-cache' \
        "https://$host/pub/meta/revision.txt?oci=$expected&attempt=$i" || :)

    if [ "$actual" = "$expected" ]; then
        verified=1
        break
    fi

    i=$((i + 1))
    sleep 2
done

[ "$verified" -eq 1 ] || {
    echo "Public verification failed" >&2
    exit 1
}

curl -fsSL \
    --connect-timeout 6 \
    --max-time 15 \
    "https://$host/?oci=$expected" \
    -o /dev/null

echo "PROMOTION PASSED: $target ($expected)"
echo "Backup: $backup"

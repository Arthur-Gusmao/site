#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
description="Cloudflare Tunnel"
command=/usr/local/bin/cloudflared
[ -x "$command" ] || command=/usr/bin/cloudflared
command_args="--no-autoupdate tunnel run --token-file /etc/cloudflared/token"
supervisor=supervise-daemon
respawn_delay=5
respawn_max=0
output_log=/var/log/cloudflared.log
error_log=/var/log/cloudflared.err
depend() {
    need net
    use dns logger
    after werc-site
}
